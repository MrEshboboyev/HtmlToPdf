<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Учёт рабочего времени</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            line-height: 1.2;
            color: #000;
            background: white;
            padding: 20px;
        }

        .header {
            text-align: left;
            margin-bottom: 20px;
            page-break-after: avoid;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .header-date {
            font-size: 10px;
            font-weight: normal;
        }

        .header-title {
            font-weight: bold;
            font-size: 16px;
            text-align: right;
            margin-left: auto;
        }

        .header-url {
            display: none;
        }

        .user-section {
            background: #f0f0f0;
            padding: 8px;
            margin: 15px 0;
            font-weight: bold;
            font-size: 12px;
            border: 1px solid #ccc;
            page-break-before: auto;
            text-align: center;
        }

        .timeline-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10px;
            font-size: 9px;
        }

            .timeline-table th,
            .timeline-table td {
                border: 1px solid #ccc;
                padding: 2px;
                text-align: center;
                vertical-align: middle;
                white-space: nowrap;
            }

                .timeline-table th.hour-cell {
                    padding: 0;
                }

                    .timeline-table th.hour-cell .hour-number {
                        display: inline-block;
                        width: calc(100% / 24);
                        border-right: 1px solid #ccc;
                        box-sizing: border-box;
                        font-size: 8px;
                        text-align: center;
                        padding: 2px 0;
                    }

                        .timeline-table th.hour-cell .hour-number:last-child {
                            border-right: none;
                        }

            .timeline-table th {
                background: #f5f5f5;
                font-weight: bold;
            }

        .date-cell {
            font-weight: bold;
            text-align: left;
            padding: 3px 5px;
            width: 100px;
        }

        .hour-cell {
            width: 25px;
            font-size: 8px;
        }

        .stats-cell {
            width: 50px;
            font-size: 8px;
            text-align: center;
        }

        .timeline-bar {
            height: 12px;
            display: flex;
            width: 100%;
        }

        .time-segment {
            height: 100%;
        }

        .productive {
            background: #90EE90; /* Yaxshiroq rang */
        }

        .unproductive {
            background: #D3D3D3; /* Yaxshiroq rang */
        }

        .neutral {
            background: #F0E68C; /* Sariq rang uchun */
        }

        .inactive {
            background: #FFF;
        }

        .productivity-section {
            margin: 15px 0;
            page-break-inside: avoid;
        }

        .productivity-title {
            font-weight: bold;
            font-size: 11px;
            margin-bottom: 10px;
            text-align: left;
        }

        .productivity-item {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            font-size: 9px;
        }

        .productivity-bar {
            height: 15px;
            background: #f0f0f0;
            position: relative;
            margin-left: 10px;
            flex: 1;
            border: 1px solid #ccc;
        }

        .productivity-fill {
            height: 100%;
            position: relative;
        }

        .productivity-text {
            position: absolute;
            left: 5px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 8px;
            font-weight: bold;
            color: #000;
            white-space: nowrap;
        }

        .category-label {
            width: 200px;
            flex-shrink: 0;
            text-align: left;
        }

        .page-break {
            page-break-before: always;
        }

        @media print {
            body {
                font-size: 9px;
            }

            .user-section {
                page-break-after: avoid;
            }

            .productivity-section {
                page-break-inside: avoid;
            }
        }
    </style>
