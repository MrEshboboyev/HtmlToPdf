<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Учёт рабочего времени</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            line-height: 1.2;
            color: #000;
            background: white;
            padding: 20px;
        }

        .report-container {
            border: 1px solid #ccc;
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #ccc;
        }

        .report-header-title {
            font-weight: bold;
            font-size: 12px;
            text-align: right;
        }

        .user-section {
            background: #f0f0f0;
            padding: 8px;
            font-weight: bold;
            font-size: 11px;
            border-bottom: 1px solid #ccc;
        }

        .timeline-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 8px;
        }

            .timeline-table th,
            .timeline-table td {
                border: 1px solid #ccc;
                padding: 2px;
                text-align: center;
                vertical-align: top;
                white-space: nowrap;
            }

            .timeline-table th {
                background: #f5f5f5;
                font-weight: bold;
            }

        .hour-row th {
            padding: 0;
            border: none;
        }

        .hour-row .hour-number {
            display: inline-block;
            width: calc(100% / 24);
            border-right: 1px solid #ccc;
            box-sizing: border-box;
            font-size: 7px;
            padding: 2px 0;
            text-align: center;
        }

            .hour-row .hour-number:last-child {
                border-right: none;
            }

        .stats-cell {
            font-size: 7px;
            white-space: nowrap;
        }

        .sub-headers td {
            font-size: 7px;
        }

        .productivity-section {
            padding: 15px;
        }

        .productivity-title {
            font-weight: bold;
            font-size: 10px;
            margin-bottom: 5px;
            text-align: left;
        }

        .productivity-item {
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            font-size: 8px;
        }

        .category-label {
            width: 200px;
            flex-shrink: 0;
            text-align: left;
        }

        .productivity-bar-container {
            height: 12px;
            background: #f0f0f0;
            position: relative;
            margin-left: 10px;
            flex: 1;
            border: 1px solid #ccc;
        }

        .productivity-bar {
            height: 100%;
            position: relative;
        }

            .productivity-bar.productive {
                background: #90EE90;
            }

            .productivity-bar.unproductive {
                background: #D3D3D3;
            }

            .productivity-bar.neutral {
                background: #F0E68C;
            }

        .productivity-text {
            position: absolute;
            left: 5px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 7px;
            font-weight: bold;
            color: #000;
            white-space: nowrap;
        }

        .date-footer-header {
            font-weight: bold;
            font-size: 11px;
            text-align: right;
            margin-top: 10px;
        }
    </style>
</head>
<body>

